# Copy to .env.local for local development. Never commit real values.

# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection string (Neon console → Connect). Used by the app.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional: direct (non-pooled) string for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Sign-in -------------------------------------------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Resend API key and a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=BSL Connect <noreply@your-verified-domain.com>

# --- AI (optional; everything else works without it) --------------------------
# "openrouter" (default) or "none". Google models only.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
# minimal | low (default) | medium | high
OPENROUTER_REASONING_EFFORT=low

# --- Optional -------------------------------------------------------------------
# Public URL (falls back to Vercel's production URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development only: print sign-in codes to the server console when Resend isn't set.
EMAIL_DEV_LOG=false
# Development only: enables /design-preview (fictional sample data).
ENABLE_DESIGN_PREVIEW=false
